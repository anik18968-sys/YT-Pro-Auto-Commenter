{
  "manifest_version": 3,
  "name": "YT Pro Auto Commenter",
  "version": "2.0",
  "description": "Advanced Auto commenter with floating UI and Save features.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "all_frames": true
    }
  ]
}